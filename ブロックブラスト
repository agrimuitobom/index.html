        const comboCount = document.getElementById('combo-count');
        const comboBonus = document.getElementById('combo-bonus');
        const actionMsg = document.getElementById('action-msg');

        // ドラッグ状態管理
        let dragSrcIndex = null;
        let activeDragEl = null;
        let dragOffset = { x: 0, y: 0 };
        
        // タッチ検出
        let touchStartPos = { x: 0, y: 0 };
        let isMovingDrag = false;
        
        // 有効ドロップ座標（離した瞬間ブレても記憶スナップで滑らか落下）
        let lastValidCell = null;

        function initGame() {
            board = Array(BOARD_SIZE).fill(null).map(() => Array(BOARD_SIZE).fill(0));
            score = 0;
            combo = 0;
            items = { shuffle: 2, deleteBlock: 1, bomb: 1 };
            activeItemMode = 'none';
            selectedHandIndex = null;
            lastValidCell = null;

            scoreValEl.textContent = score;
            bestValEl.textContent = bestScore;

            createBoardCells();
            generateHand();
            hideGameover();
            hideActionMessage();
            hideComboBadge();
            updateItemUI();
        }

        // 盤面格子のセルを作成
        function createBoardCells() {
            boardEl.innerHTML = '';
            for (let r = 0; r < BOARD_SIZE; r++) {
                for (let c = 0; c < BOARD_SIZE; c++) {
                    const cell = document.createElement('div');
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    // 暗朱と漆黒のコントラストによる伝統的なボードスタイル
                    const bgClass = (r + c) % 2 === 0 ? 'bg-[#1c080d]/90' : 'bg-[#0f0205]/95';
                    cell.className = `grid-cell w-full h-full rounded-lg ${bgClass} border border-amber-900/10 transition-all duration-150 flex items-center justify-center cursor-pointer`;
                    
                    cell.addEventListener('click', () => handleCellClick(r, c));
                    
                    boardEl.appendChild(cell);
                }
            }
            updateBoardUI();
        }

        function updateBoardUI() {
            const cells = boardEl.children;
            for (let r = 0; r < BOARD_SIZE; r++) {
                for (let c = 0; c < BOARD_SIZE; c++) {
                    const idx = r * BOARD_SIZE + c;
                    const cell = cells[idx];
                    const val = board[r][c];

                    const baseBg = (r + c) % 2 === 0 ? 'bg-[#1c080d]/90' : 'bg-[#0f0205]/95';
                    cell.className = `grid-cell w-full h-full rounded-lg ${baseBg} border border-amber-900/10 transition-all duration-150 flex items-center justify-center cursor-pointer`;
                    cell.innerHTML = '';

                    if (val !== 0) {
                        const colorData = COLOR_MAP[val];
                        cell.classList.remove('bg-[#1c080d]/90', 'bg-[#0f0205]/95', 'border-amber-900/10');
                        // 七宝焼き調の高級感あふれる金枠ゴールドラインを施す
                        cell.classList.add('oriental-block', 'bg-gradient-to-br', ...colorData.tailwind.split(' '), 'scale-95', 'rounded-lg');
                        
                        const sheen = document.createElement('div');
                        sheen.className = 'w-full h-full border-t border-l border-white/35 rounded-lg';
                        cell.appendChild(sheen);
                    }
                }
            }
        }

        function generateHand() {
            hand = [getRandomShape(), getRandomShape(), getRandomShape()];
            renderHand();
            checkGameOver();
        }

        function getRandomShape() {
            const idx = Math.floor(Math.random() * SHAPES.length);
            return JSON.parse(JSON.stringify(SHAPES[idx]));
        }

        function renderHand() {
            handContainerEl.innerHTML = '';
            hand.forEach((block, index) => {
                const wrapper = document.createElement('div');
                const isSelected = (selectedHandIndex === index);
                const selectClass = isSelected ? 'selected-hand-slot' : '';
                wrapper.className = `flex-1 h-full flex flex-col items-center justify-center cursor-grab active:cursor-grabbing relative p-1 transition-all duration-150 ${selectClass}`;
                wrapper.dataset.index = index;

                if (!block) {
                    wrapper.innerHTML = `<div class="text-amber-900/30 text-xs font-bold serif-font">🏮</div>`;
                    handContainerEl.appendChild(wrapper);
                    return;
                }

                const matrix = block.matrix;
                const rows = matrix.length;
                const cols = matrix[0].length;

                const blockGrid = document.createElement('div');
                blockGrid.className = 'grid gap-0.5 pointer-events-none transition-transform duration-100';
                blockGrid.style.gridTemplateRows = `repeat(${rows}, minmax(0, 1fr))`;
                blockGrid.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`;
                
                // ブロック形状のサイズに応じてセルの大きさを絶妙に可変
                const cellSizeClass = rows > 2 || cols > 2 ? 'w-2.5 h-2.5' : 'w-3.5 h-3.5';
                const colorData = COLOR_MAP[block.colorKey];

                for (let r = 0; r < rows; r++) {
                    for (let c = 0; c < cols; c++) {
                        const cell = document.createElement('div');
                        cell.className = `rounded-md ${cellSizeClass} shadow-md`;
                        if (matrix[r][c] === 1) {
                            cell.className += ` oriental-block bg-gradient-to-br ${colorData.tailwind}`;
                        } else {
                            cell.className += ' bg-transparent';
                        }
                        blockGrid.appendChild(cell);
                    }
                }

                wrapper.appendChild(blockGrid);

                // マウス・タッチ操作のバインド
                wrapper.addEventListener('mousedown', (e) => startDrag(e, index, e.clientX, e.clientY));
                wrapper.addEventListener('touchstart', (e) => {
                    const touch = e.touches[0];
                    startDrag(e, index, touch.clientX, touch.clientY);
                }, { passive: false });

                handContainerEl.appendChild(wrapper);
            });
        }

        // ドラッグ開始
        function startDrag(e, index, clientX, clientY) {
            if (activeItemMode !== 'none') {
                if (activeItemMode === 'deleteBlock') {
                    handleHandClick(index);
                }
                return;
            }
            const block = hand[index];
            if (!block) return;

            e.preventDefault();
            initAudio();

            dragSrcIndex = index;
            touchStartPos = { x: clientX, y: clientY };
            isMovingDrag = false;
            lastValidCell = null;

            // ドラッグ開始時のみ画面バウンスを防ぐ
            document.documentElement.style.touchAction = 'none';
            document.body.style.touchAction = 'none';

            if (e.type.startsWith('touch')) {
                window.addEventListener('touchmove', handleMoveTouch, { passive: false });
                window.addEventListener('touchend', handleEndTouch, { passive: false });
            } else {
                window.addEventListener('mousemove', handleMoveMouse);
                window.addEventListener('mouseup', handleEndMouse);
            }
        }

        // ドラッグ用クローンの生成（指に隠れないよう自動的に浮かせる）
        function activateDragVisuals(clientX, clientY) {
            const index = dragSrcIndex;
            const block = hand[index];
            if (!block) return;

            const origSlot = handContainerEl.querySelector(`[data-index="${index}"]`);
            if (!origSlot) return;

            const blockGridOrig = origSlot.querySelector('.grid');
            if (!blockGridOrig) return;
            blockGridOrig.classList.add('opacity-20');

            const rect = blockGridOrig.getBoundingClientRect();

            activeDragEl = blockGridOrig.cloneNode(true);
            activeDragEl.classList.add('fixed', 'pointer-events-none', 'z-50', 'transform', 'scale-110', 'drag-shadow');
            
            activeDragEl.style.width = `${rect.width}px`;
            activeDragEl.style.height = `${rect.height}px`;

            const liftY = 60;
            dragOffset = {
                x: rect.width / 2,
                y: rect.height / 2 + liftY
            };

            updateDragElementPosition(clientX, clientY);
            document.body.appendChild(activeDragEl);
        }

        function handleMoveMouse(e) {
            if (dragSrcIndex === null) return;
            
            const dist = Math.hypot(e.clientX - touchStartPos.x, e.clientY - touchStartPos.y);
            if (!isMovingDrag && dist > 8) {
                isMovingDrag = true;
                activateDragVisuals(e.clientX, e.clientY);
            }

            if (isMovingDrag && activeDragEl) {
                updateDragElementPosition(e.clientX, e.clientY);
                const targetCell = getCellFromCoords(e.clientX, e.clientY);
                clearGhostPreview();
                if (targetCell) {
                    showGhostPreview(dragSrcIndex, targetCell.row, targetCell.col);
                } else {
                    lastValidCell = null;
                }
            }
        }

        function handleEndMouse(e) {
            window.removeEventListener('mousemove', handleMoveMouse);
            window.removeEventListener('mouseup', handleEndMouse);
            
            if (!isMovingDrag) {
                handleHandSelect(dragSrcIndex);
            } else {
                finishDrag(e.clientX, e.clientY);
            }
            dragSrcIndex = null;
            
            // スクロールロック解除
            document.documentElement.style.touchAction = '';
            document.body.style.touchAction = '';
        }

        function handleMoveTouch(e) {
            if (dragSrcIndex === null) return;
            e.preventDefault(); // ドラッグ中の画面バウンスを100%防止
            const touch = e.touches[0];

            const dist = Math.hypot(touch.clientX - touchStartPos.x, touch.clientY - touchStartPos.y);
            if (!isMovingDrag && dist > 8) {
                isMovingDrag = true;
                activateDragVisuals(touch.clientX, touch.clientY);
            }

            if (isMovingDrag && activeDragEl) {
                updateDragElementPosition(touch.clientX, touch.clientY);
                const targetCell = getCellFromCoords(touch.clientX, touch.clientY);
                clearGhostPreview();
                if (targetCell) {
                    showGhostPreview(dragSrcIndex, targetCell.row, targetCell.col);
                } else {
                    lastValidCell = null;
                }
            }
        }

        function handleEndTouch(e) {
            e.preventDefault();
            window.removeEventListener('touchmove', handleMoveTouch);
            window.removeEventListener('touchend', handleEndTouch);
            
            if (!isMovingDrag) {
                handleHandSelect(dragSrcIndex);
            } else {
                const touch = e.changedTouches[0];
                finishDrag(touch.clientX, touch.clientY);
            }
            dragSrcIndex = null;

            // スクロールロック解除
            document.documentElement.style.touchAction = '';
            document.body.style.touchAction = '';
        }

        function updateDragElementPosition(clientX, clientY) {
            if (activeDragEl) {
                activeDragEl.style.left = `${clientX - dragOffset.x}px`;
                activeDragEl.style.top = `${clientY - dragOffset.y}px`;
            }
        }

        // 座標から最も適切なセル位置をマッピングする高精度スナップ
        function getCellFromCoords(x, y) {
            if (!activeDragEl || dragSrcIndex === null) return null;

            const block = hand[dragSrcIndex];
            if (!block) return null;

            const matrix = block.matrix;
            const blockRows = matrix.length;
            const blockCols = matrix[0].length;

            const blockLeft = x - dragOffset.x;
            const blockTop = y - dragOffset.y;

            const boardRect = boardEl.getBoundingClientRect();
            
            const colWidth = boardRect.width / BOARD_SIZE;
            const rowHeight = boardRect.height / BOARD_SIZE;

            const col = Math.round((blockLeft - boardRect.left) / colWidth);
            const row = Math.round((blockTop - boardRect.top) / rowHeight);

            if (row >= 0 && row + blockRows <= BOARD_SIZE && col >= 0 && col + blockCols <= BOARD_SIZE) {
                return { row, col };
            }
            return null;
        }

        // ドロップ予測位置をゴールドに点灯
        function showGhostPreview(handIdx, boardRow, boardCol) {
            const block = hand[handIdx];
            if (!block) return;

            const matrix = block.matrix;
            const rows = matrix.length;
            const cols = matrix[0].length;

            if (canPlace(matrix, boardRow, boardCol)) {
                lastValidCell = { row: boardRow, col: boardCol };
                
                const cells = boardEl.children;
                for (let r = 0; r < rows; r++) {
                    for (let c = 0; c < cols; c++) {
                        if (matrix[r][c] === 1) {
                            const targetIdx = (boardRow + r) * BOARD_SIZE + (boardCol + c);
                            if (targetIdx < cells.length) {
                                cells[targetIdx].classList.add('bg-amber-600/30', 'ring-2', 'ring-amber-400/50', 'scale-105');
                            }
                        }
                    }
                }
            } else {
                lastValidCell = null;
            }
        }

        function clearGhostPreview() {
            const cells = boardEl.children;
            for (let cell of cells) {
                cell.classList.remove('bg-amber-600/30', 'ring-2', 'ring-amber-400/50', 'scale-105');
            }
        }

        // 指を離したときのドロップ確定処理
        function finishDrag(clientX, clientY) {
            if (dragSrcIndex === null) return;

            const origSlot = handContainerEl.querySelector(`[data-index="${dragSrcIndex}"]`);
            if (origSlot) {
                const blockGridOrig = origSlot.querySelector('.grid');
                if (blockGridOrig) {
                    blockGridOrig.classList.remove('opacity-20');
                }
            }

            if (activeDragEl) {
                activeDragEl.remove();
                activeDragEl = null;
            }

            clearGhostPreview();

            let targetCell = getCellFromCoords(clientX, clientY);
            
            const block = hand[dragSrcIndex];
            if (block) {
                const canPlaceAtTarget = targetCell && canPlace(block.matrix, targetCell.row, targetCell.col);
                if (!canPlaceAtTarget && lastValidCell) {
                    targetCell = lastValidCell;
                }
            }

            if (targetCell) {
                tryPlaceBlock(dragSrcIndex, targetCell.row, targetCell.col);
            }
            
            lastValidCell = null;
        }

        // 手札のタップ選択制御（Tap-to-Place）
        function handleHandSelect(index) {
            if (selectedHandIndex === index) {
                selectedHandIndex = null;
                hideActionMessage();
            } else {
                selectedHandIndex = index;
                playSound('item');
                showActionMessage("配置したい盤面のマス（左上が基準）をタップしてね");
            }
            renderHand();
        }

        // 盤面タップ時の配置・破壊判定
        function handleCellClick(row, col) {
            if (activeItemMode === 'bomb') {
                if (board[row][col] === 0) return;
                const idx = row * BOARD_SIZE + col;
                const cell = boardEl.children[idx];
                cell.classList.add('cell-pop');

                setTimeout(() => {
                    board[row][col] = 0;
                    items.bomb--;
                    playSound('item');
                    cancelItemMode();
                    updateItemUI();
                    updateBoardUI();
                    checkLines();
                    checkGameOver();
                }, 200);
                return;
            }

            // タップ＆タップでの配置処理
            if (selectedHandIndex !== null) {
                const block = hand[selectedHandIndex];
                if (!block) {
                    selectedHandIndex = null;
                    renderHand();
                    return;
                }

                const matrix = block.matrix;
                if (canPlace(matrix, row, col)) {
                    const tempIndex = selectedHandIndex;
                    selectedHandIndex = null; 
                    hideActionMessage();
                    tryPlaceBlock(tempIndex, row, col);
                } else {
                    showActionMessage("そこには配置できません！空いた場所を選んでね");
                    setTimeout(() => {
                        if (selectedHandIndex !== null) {
                            showActionMessage("配置したい盤面のマス（左上が基準）をタップしてね");
                        }
                    }, 1500);
                }
            }
        }

        function canPlace(matrix, startRow, startCol) {
            const rows = matrix.length;
            const cols = matrix[0].length;

            if (startRow + rows > BOARD_SIZE || startCol + cols > BOARD_SIZE) {
                return false;
            }

            for (let r = 0; r < rows; r++) {
                for (let c = 0; c < cols; c++) {
                    if (matrix[r][c] === 1) {
                        if (board[startRow + r][startCol + c] !== 0) {
                            return false;
                        }
                    }
                }
            }
            return true;
        }

        function tryPlaceBlock(handIdx, boardRow, boardCol) {
            const block = hand[handIdx];
            if (!block) return;

            const matrix = block.matrix;
            const rows = matrix.length;
            const cols = matrix[0].length;

            if (canPlace(matrix, boardRow, boardCol)) {
                let cellCount = 0;
                for (let r = 0; r < rows; r++) {
                    for (let c = 0; c < cols; c++) {
                        if (matrix[r][c] === 1) {
                            board[boardRow + r][boardCol + c] = block.colorKey;
                            cellCount++;
                        }
                    }
                }

                addScore(cellCount);
                playSound('place');

                hand[handIdx] = null;
                renderHand();

                checkLines();

                if (hand.every(b => b === null)) {
                    generateHand();
                } else {
                    checkGameOver();
                }

                updateBoardUI();
            }
        }

        function checkLines() {
            let fullRows = [];
            let fullCols = [];

            for (let r = 0; r < BOARD_SIZE; r++) {
                if (board[r].every(cell => cell !== 0)) {
                    fullRows.push(r);
                }
            }

            for (let c = 0; c < BOARD_SIZE; c++) {
                let colFull = true;
                for (let r = 0; r < BOARD_SIZE; r++) {
                    if (board[r][c] === 0) {
                        colFull = false;
                        break;
                    }
                }
                if (colFull) {
                    fullCols.push(c);
                }
            }

            const totalLinesCleared = fullRows.length + fullCols.length;

            if (totalLinesCleared > 0) {
                combo++;
                
                const cells = boardEl.children;
                
                fullRows.forEach(r => {
                    for (let c = 0; c < BOARD_SIZE; c++) {
                        const cell = cells[r * BOARD_SIZE + c];
                        cell.classList.add('cell-pop');
                    }
                });
                fullCols.forEach(c => {
                    for (let r = 0; r < BOARD_SIZE; r++) {
                        const cell = cells[r * BOARD_SIZE + c];
                        cell.classList.add('cell-pop');
                    }
                });

                setTimeout(() => {
                    fullRows.forEach(r => {
                        board[r] = Array(BOARD_SIZE).fill(0);
                    });
                    fullCols.forEach(c => {
                        for (let r = 0; r < BOARD_SIZE; r++) {
                            board[r][c] = 0;
                        }
                    });

                    const baseClearScore = ((totalLinesCleared * (totalLinesCleared + 1)) / 2) * 100;
                    const comboBonusPoints = combo > 1 ? (combo - 1) * 50 : 0;
                    const finalGain = baseClearScore + comboBonusPoints;

                    addScore(finalGain);

                    if (combo > 1) {
                        showComboBadge(combo, comboBonusPoints);
                        playSound('combo');
                    } else {
                        playSound('clear');
                    }

                    updateBoardUI();
                    checkGameOver();
                }, 350);

            } else {
                combo = 0;
                hideComboBadge();
            }
        }

        function checkGameOver() {
            const activeHandIndices = [];
            hand.forEach((b, idx) => {
                if (b !== null) activeHandIndices.push(idx);
            });

            if (activeHandIndices.length === 0) return;

            let anyCanPlace = false;

            for (let handIdx of activeHandIndices) {
                const block = hand[handIdx];
                const matrix = block.matrix;

                for (let r = 0; r < BOARD_SIZE; r++) {
                    for (let c = 0; c < BOARD_SIZE; c++) {
                        if (canPlace(matrix, r, c)) {
                            anyCanPlace = true;
                            break;
                        }
                    }
                    if (anyCanPlace) break;
                }
                if (anyCanPlace) break;
            }

            if (!anyCanPlace) {
                if (items.shuffle === 0 && items.deleteBlock === 0 && items.bomb === 0) {
                    showGameOver();
                } else {
                    showActionMessage("配置不可！天命のパワーアップを使いましょう！");
                }
            } else {
                if (activeItemMode === 'none' && selectedHandIndex === null) {
                    hideActionMessage();
                }
            }
        }

        function addScore(points) {
            score += points;
            scoreValEl.textContent = score;

            if (score > bestScore) {
                bestScore = score;
                bestValEl.textContent = bestScore;
                localStorage.setItem('block_blast_best_dynasty_2d', bestScore);
            }
        }

        // パワーアップアイテム機能
        function updateItemUI() {
            countShuffle.textContent = items.shuffle;
            countDeleteBlock.textContent = items.deleteBlock;
            countBomb.textContent = items.bomb;

            btnShuffle.disabled = items.shuffle <= 0;
            btnShuffle.style.opacity = items.shuffle <= 0 ? "0.3" : "1";

            btnDeleteBlock.disabled = items.deleteBlock <= 0;
            btnDeleteBlock.style.opacity = items.deleteBlock <= 0 ? "0.3" : "1";

            btnBomb.disabled = items.bomb <= 0;
            btnBomb.style.opacity = items.bomb <= 0 ? "0.3" : "1";
        }

        btnShuffle.addEventListener('click', () => {
            if (items.shuffle <= 0) return;
            initAudio();
            
            selectedHandIndex = null;
            hand = hand.map(b => b === null ? null : getRandomShape());
            items.shuffle--;
            playSound('item');
            updateItemUI();
            renderHand();
            checkGameOver();
        });

        btnDeleteBlock.addEventListener('click', () => {
            if (items.deleteBlock <= 0) return;
            initAudio();

            selectedHandIndex = null;
            if (activeItemMode === 'deleteBlock') {
                cancelItemMode();
            } else {
                activeItemMode = 'deleteBlock';
                showActionMessage("消去したい手札のブロックをタップしてください");
                highlightDeleteBlockTargets(true);
            }
        });

        function handleHandClick(index) {
            if (activeItemMode !== 'deleteBlock') return;
            if (hand[index] === null) return;

            hand[index] = null;
            items.deleteBlock--;
            
            playSound('item');
            cancelItemMode();
            updateItemUI();
            renderHand();

            if (hand.every(b => b === null)) {
                generateHand();
            } else {
                checkGameOver();
            }
        }

        function highlightDeleteBlockTargets(active) {
            const wrappers = handContainerEl.children;
            for (let i = 0; i < wrappers.length; i++) {
                if (hand[i] !== null) {
                    if (active) {
                        wrappers[i].classList.add('ring-4', 'ring-red-500', 'animate-pulse');
                    } else {
                        wrappers[i].classList.remove('ring-4', 'ring-red-500', 'animate-pulse');
                    }
                }
            }
        }

        btnBomb.addEventListener('click', () => {
            if (items.bomb <= 0) return;
            initAudio();

            selectedHandIndex = null;
            if (activeItemMode === 'bomb') {
                cancelItemMode();
            } else {
                activeItemMode = 'bomb';
                showActionMessage("破壊したい盤面の1マスをタップしてください");
                highlightBombTargets(true);
            }
        });

        function highlightBombTargets(active) {
            const cells = boardEl.children;
            for (let r = 0; r < BOARD_SIZE; r++) {
                for (let c = 0; c < BOARD_SIZE; c++) {
                    const idx = r * BOARD_SIZE + c;
                    const cell = cells[idx];
                    if (board[r][c] !== 0) {
                        if (active) {
                            cell.classList.add('ring-4', 'ring-yellow-500/70', 'animate-pulse');
                        } else {
                            cell.classList.remove('ring-4', 'ring-yellow-500/70', 'animate-pulse');
                        }
                    }
                }
            }
        }

        function cancelItemMode() {
            highlightDeleteBlockTargets(false);
            highlightBombTargets(false);
            activeItemMode = 'none';
            hideActionMessage();
            renderHand();
        }

        function showActionMessage(msg) {
            actionMsg.textContent = msg;
            actionMsg.classList.remove('hidden');
        }

        function hideActionMessage() {
            actionMsg.classList.add('hidden');
        }

        function showComboBadge(comboNum, bonus) {
            comboCount.textContent = comboNum;
            comboBonus.textContent = bonus;
            comboBadge.classList.remove('hidden');
            comboBadge.style.transform = 'scale(1)';
        }

        function hideComboBadge() {
            comboBadge.classList.add('hidden');
            comboBadge.style.transform = 'scale(0)';
        }

        function showGameOver() {
            playSound('gameover');
            finalScoreEl.textContent = score;
            finalBestEl.textContent = bestScore;
            gameoverModalEl.classList.remove('hidden');
            setTimeout(() => {
                gameoverModalEl.querySelector('div').classList.remove('scale-95');
                gameoverModalEl.querySelector('div').classList.add('scale-100');
            }, 10);
        }

        function hideGameover() {
            gameoverModalEl.classList.add('hidden');
            gameoverModalEl.querySelector('div').classList.remove('scale-100');
            gameoverModalEl.querySelector('div').classList.add('scale-95');
        }

        btnRestart.addEventListener('click', initGame);

        window.onload = function() {
            initGame();
        };
    </script>
</body>
