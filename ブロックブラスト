<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Block Blast - 華雅王朝宮廷版</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons for UI -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: 中華風の美しさを際立たせる毛筆調＆優美なセリフ体 -->
    <link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+JP:wght@600;900&family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
    
    <style>
        body, html {
            font-family: 'Outfit', 'Noto Serif JP', 'Segoe UI', sans-serif;
            /* 豪華な深紅（朱砂）と漆黒が織りなす中国宮廷風グラデーション背景 */
            background: radial-gradient(circle at center, #3b0712 0%, #0c0104 100%);
            user-select: none;
            -webkit-user-select: none;
            overflow-x: hidden;
            overflow-y: auto; /* 縦スクロールを有効化 */
            width: 100%;
            height: 100%;
            scroll-behavior: smooth;
        }
        .chinese-font {
            font-family: 'Ma Shan Zheng', cursive, 'Noto Serif JP', serif;
        }
        .serif-font {
            font-family: 'Noto Serif JP', serif;
        }
        /* 中華意匠：豪華な雷紋（ゴールド・フレットパターン）を模した宮廷風ボーダー */
        .dynasty-border {
            border: 4px solid;
            border-image: linear-gradient(to bottom, #f59e0b, #d97706, #fef08a, #b45309, #f59e0b) 1;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.85), inset 0 0 20px rgba(180, 83, 9, 0.4);
            position: relative;
        }
        /* 盤面の四隅に配置する伝統的な祥雲紋（飾り枠）のシミュレート */
        .dynasty-border::before {
            content: '🏮';
            position: absolute;
            top: -12px;
            left: -12px;
            font-size: 16px;
            z-index: 10;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
        }
        .dynasty-border::after {
            content: '🏮';
            position: absolute;
            top: -12px;
            right: -12px;
            font-size: 16px;
            z-index: 10;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
        }
        /* 金糸で装飾された伝統の色彩テキスト */
        .dynasty-gold-text {
            background: linear-gradient(to right, #ffe082, #ffd54f, #ffb300, #ff8f00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 2px 4px rgba(0,0,0,0.4);
        }
        /* 2Dグリッドのセル：高級な黒漆塗りの器をイメージした深み */
        .grid-cell {
            box-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.9), inset 0 -1px 2px rgba(255, 255, 255, 0.03);
            touch-action: none;
            background: #110306;
        }
        /* ドラッグ中のブロックのスタイル */
        .dragging {
            opacity: 0.15;
            transform: scale(0.85);
        }
        /* 手札が選択された時の中華ランタン風のゆらめきパルス */
        @keyframes dragon-pulse {
            0%, 100% { box-shadow: 0 0 8px #f59e0b, inset 0 0 6px rgba(217, 119, 6, 0.5); border-color: rgba(245, 158, 11, 0.7); }
            50% { box-shadow: 0 0 24px #b45309, inset 0 0 16px rgba(180, 83, 9, 0.9); border-color: rgba(180, 83, 9, 1); }
        }
        .selected-hand-slot {
            animation: dragon-pulse 1.2s infinite;
            background: rgba(180, 83, 9, 0.15) !important;
            border: 2px solid #b45309 !important;
            border-radius: 14px;
        }
        /* 伝統工芸「七宝焼き（Cloisonné）」をイメージした金糸縁取りの高級2Dブロック */
        .oriental-block {
            position: relative;
            box-shadow: 
                inset 0 4px 5px rgba(255, 255, 255, 0.45), 
                inset 0 -5px 6px rgba(0, 0, 0, 0.5),
                0 4px 10px rgba(0, 0, 0, 0.65);
            /* 各セグメントを分かつ優美な金糸（金枠）の表現 */
            border: 1.5px solid #fbbf24;
        }
        .oriental-block::after {
            content: '';
            position: absolute;
            top: 10%;
            left: 10%;
            width: 80%;
            height: 28%;
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 100%);
            border-radius: 3px;
            pointer-events: none;
        }
        /* 龍の息吹：ブロックが昇天（消滅）する際のエフェクト */
        @keyframes dragon-pop {
            0% { transform: scale(1); filter: brightness(1); opacity: 1; }
            30% { transform: scale(1.18); filter: brightness(1.9) saturate(1.5); opacity: 0.95; }
            100% { transform: scale(0); filter: brightness(2.5); opacity: 0; }
        }
        .cell-pop {
            animation: dragon-pop 0.38s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        /* ドラッグ中に生まれるリアルな影 */
        .drag-shadow {
            filter: drop-shadow(0 15px 12px rgba(0, 0, 0, 0.7));
        }
    </style>
</head>
