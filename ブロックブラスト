    <script>
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioCtx();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        // 古筝 (Guzheng) や 木魚 (Muyu) をWeb Audio APIで生成する
        function playSound(type) {
            try {
                initAudio();
                if (!audioCtx) return;

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'place') {
                    // 木魚 (Muyu) の乾いた心地よいポクッという打撃音
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(320, now);
                    // 急速に周波数を落として木魚特有の響きを作る
                    osc.frequency.exponentialRampToValueAtTime(140, now + 0.08);
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (type === 'clear') {
                    // 古筝 (Guzheng) の爪弾きサウンド (和音)
                    // 青・紅・金の清冽な五声調（宮・商・角・徴・羽）
                    const freqs = [329.63, 392.00, 440.00, 523.25, 587.33]; // E4, G4, A4, C5, D5
                    freqs.forEach((freq, idx) => {
                        const subOsc = audioCtx.createOscillator();
                        const subGain = audioCtx.createGain();
                        subOsc.type = 'sine';
                        subOsc.frequency.setValueAtTime(freq, now + idx * 0.04); // アルペジオ(流れる弾き方)
                        subGain.gain.setValueAtTime(0.08, now + idx * 0.04);
                        subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.35 + idx * 0.04);
                        
                        subOsc.connect(subGain);
                        subGain.connect(audioCtx.destination);
                        subOsc.start(now + idx * 0.04);
                        subOsc.stop(now + 0.45);
                    });
                } else if (type === 'combo') {
                    // コンボ時の五声調上昇アルペジオ
                    const rootFreq = 261.63; // C4
                    const steps = [1, 1.125, 1.25, 1.5, 1.667, 2.0]; // ペンタトニックスケールの比率
                    const currentStep = steps[Math.min(combo, steps.length - 1)];
                    
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(rootFreq * currentStep, now);
                    osc.frequency.exponentialRampToValueAtTime(rootFreq * currentStep * 1.5, now + 0.25);
                    gain.gain.setValueAtTime(0.18, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (type === 'item') {
                    // 悠久の宮廷のベル/編鐘の響き
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, now); // D5
                    osc.frequency.setValueAtTime(783.99, now + 0.06); // G5
                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (type === 'gameover') {
                    // 重厚な銅鑼 (Gong) の崩壊音
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(200, now);
                    osc.frequency.linearRampToValueAtTime(50, now + 0.65);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.7);
                    osc.start(now);
                    osc.stop(now + 0.7);
                }
            } catch (e) {
                console.log("Audio playing issue: ", e);
            }
        }
    </script>

    <script>
        const BOARD_SIZE = 8;
        let board = Array(BOARD_SIZE).fill(null).map(() => Array(BOARD_SIZE).fill(0));
        let score = 0;
        let bestScore = parseInt(localStorage.getItem('block_blast_best_dynasty_2d') || '0');
        let hand = [null, null, null];
        let combo = 0;

        // タップ＆配置用
        let selectedHandIndex = null;

        let items = { shuffle: 2, deleteBlock: 1, bomb: 1 };
        let activeItemMode = 'none';

        // 中国伝統工芸・鉱物・玉石に基づく格式高い伝統色カラーマップ
        const COLOR_MAP = {
            yellow: { name: "黄金 (帝王金)", tailwind: 'from-amber-300 via-yellow-500 to-amber-700' }, // 皇帝の金色
            green: { name: "翡翠 (ジェイド)", tailwind: 'from-emerald-400 via-teal-500 to-emerald-800' }, // 瑞祥の翡翠色
            cyan: { name: "青花 (コバルト)", tailwind: 'from-cyan-400 via-sky-500 to-blue-800' }, // 青花磁器の藍青
            purple: { name: "紫檀 (サンダル)", tailwind: 'from-fuchsia-400 via-purple-600 to-purple-950' }, // 高貴な紫檀木
            pink: { name: "朱砂 (シナバー)", tailwind: 'from-red-400 via-rose-600 to-red-950' }, // 魔除けの辰砂
            orange: { name: "珊瑚 (コーラル)", tailwind: 'from-orange-400 via-orange-500 to-red-700' }, // 吉兆の紅珊瑚
            lime: { name: "碧玉 (ジャスパー)", tailwind: 'from-lime-400 via-lime-600 to-green-800' } // 美しい碧玉色
        };

        const SHAPES = [
            // --- 通常・標準ブロック ---
            { matrix: [[1]], colorKey: 'yellow' },
            { matrix: [[1, 1]], colorKey: 'green' },
            { matrix: [[1], [1]], colorKey: 'green' },
            { matrix: [[1, 1, 1]], colorKey: 'cyan' },
            { matrix: [[1], [1], [1]], colorKey: 'cyan' },
            { matrix: [[1, 1], [1, 1]], colorKey: 'orange' },
            { matrix: [[1, 0], [1, 0], [1, 1]], colorKey: 'purple' },
            { matrix: [[1, 1, 1], [1, 0, 0]], colorKey: 'purple' },
            { matrix: [[1, 1], [0, 1], [0, 1]], colorKey: 'purple' },
            { matrix: [[0, 0, 1], [1, 1, 1]], colorKey: 'purple' },
            { matrix: [[1, 1, 1], [0, 1, 0]], colorKey: 'pink' },
            { matrix: [[1, 1, 0], [0, 1, 1]], colorKey: 'lime' },
            { matrix: [[0, 1, 1], [1, 1, 0]], colorKey: 'lime' },
            
            // --- 高難易度・特殊ブロック（追加分） ---
            { matrix: [[1, 1, 1, 1]], colorKey: 'cyan' }, // 4マス直線（横）
            { matrix: [[1], [1], [1], [1]], colorKey: 'cyan' }, // 4マス直線（縦）
            { matrix: [[1, 1, 1], [1, 1, 1], [1, 1, 1]], colorKey: 'orange' }, // 3x3 巨大キューブ（置くのがとても難しい！）
            { matrix: [[0, 1, 0], [1, 1, 1], [0, 1, 0]], colorKey: 'pink' }, // 十字（クロス型・5マス）
            { matrix: [[1, 0, 1], [1, 1, 1]], colorKey: 'yellow' }, // U字（コ字型・5マス）
            { matrix: [[1, 1, 1, 1], [1, 0, 0, 0]], colorKey: 'purple' }, // 巨大変形L字（5マス）
            { matrix: [[1, 1, 0], [0, 1, 0], [0, 1, 1]], colorKey: 'lime' } // Z型ペントミノ（5マス）
        ];

        // DOM要素
        const boardEl = document.getElementById('game-board');
        const scoreValEl = document.getElementById('score-val');
        const bestValEl = document.getElementById('best-val');
        const handContainerEl = document.getElementById('hand-container');
